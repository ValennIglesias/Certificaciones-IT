# Cabeceras de Cloudflare Pages. Equivalente al bloque "headers" de vercel.json.
# Cloudflare lee este archivo de la raíz de dist/ (por eso vive en public/).

# Los archivos de /_astro/ llevan hash en el nombre: se pueden cachear para siempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# La copia en *.pages.dev no debe indexarse: el sitio canónico es el dominio
# propio (SITE_URL). Sin esto, Google podría ver dos copias del mismo contenido.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
