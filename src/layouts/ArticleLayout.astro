---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleRow from '../components/ArticleRow.astro';
import AdSlot from '../components/AdSlot.astro';
import AuthorBox from '../components/AuthorBox.astro';
import TableOfContents from '../components/TableOfContents.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, CLUSTERS, type ClusterId } from '../consts';
import { articlePath, articleSlug, formatDate, readingTime, type Article } from '../lib/articles';
import { authorPath, getAuthor, personSchema } from '../lib/authors';

interface Props {
	article: Article;
	related: Article[];
	headings: MarkdownHeading[];
}

const { article, related, headings } = Astro.props;
const { title, description, cluster, pubDate, updatedDate, author, keyword, heroImage, heroAlt } =
	article.data;

const clusterId = cluster as ClusterId;
const clusterMeta = CLUSTERS[clusterId];
const url = new URL(articlePath(article), Astro.site).toString();
const minutes = readingTime(article.body);
const authorData = getAuthor(author);
// Si el fallback sumó artículos de otro cluster, el título no puede prometer
// que todos son del cluster actual, y cada fila muestra su cluster.
const relatedMixed = related.some((a) => a.data.cluster !== cluster);

// Open Graph propia, generada con el título real del artículo. En un preview
// de WhatsApp o LinkedIn el título legible rinde más que una placa genérica.
const ogImage = `/og/${clusterId}-${articleSlug(article)}.jpg`;

const imageUrl = heroImage
	? new URL(heroImage.src, Astro.site).toString()
	: new URL(`/og/${clusterId}-${articleSlug(article)}.jpg`, Astro.site).toString();

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	image: [imageUrl],
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: personSchema(authorData, Astro.site),
	publisher: {
		'@type': 'Organization',
		'@id': `${Astro.site?.toString()}#organization`,
		name: SITE.name,
		url: Astro.site?.toString(),
	},
	mainEntityOfPage: { '@type': 'WebPage', '@id': url },
	articleSection: clusterMeta.name,
	keywords: keyword,
	inLanguage: SITE.lang,
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: Astro.site?.toString() },
		{
			'@type': 'ListItem',
			position: 2,
			name: clusterMeta.name,
			item: new URL(`/${clusterId}/`, Astro.site).toString(),
		},
		{ '@type': 'ListItem', position: 3, name: title, item: url },
	],
};
---

<BaseLayout
	title={title}
	description={description}
	type="article"
	image={ogImage}
	imageAlt={title}
	publishedTime={pubDate}
	modifiedTime={updatedDate ?? pubDate}
	author={authorData.name}
	section={clusterMeta.name}
	accent={clusterId}>
	<Fragment slot="head">
		<JsonLd schema={articleSchema} />
		<JsonLd schema={breadcrumbSchema} />
	</Fragment>

	<article class="wrap">
		<div class="miga">
			<Breadcrumbs
				items={[
					{ label: 'Inicio', href: '/' },
					{ label: clusterMeta.name, href: `/${clusterId}/` },
					{ label: title },
				]}
			/>
		</div>

		<header class="rail cabecera rule-t">
			{/* Riel: metadatos apilados, sin separadores. */}
			<div class="riel">
				<a href={`/${clusterId}/`} class="cluster-tag">{clusterMeta.short}</a>
				<time datetime={pubDate.toISOString()} class="meta figure">{formatDate(pubDate)}</time>
				{
					updatedDate && (
						<span class="meta figure">
							Actualizado el <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
						</span>
					)
				}
				<span class="meta figure">{minutes} min de lectura</span>
				<a href={authorPath(authorData)} class="meta autor-link">{authorData.name}</a>
			</div>

			<div>
				<h1 class="title">{title}</h1>
				<p class="bajada">{description}</p>
			</div>
		</header>

		{
			heroImage && (
				<Image
					src={heroImage}
					alt={heroAlt ?? ''}
					widths={[640, 960, 1280]}
					sizes="(min-width: 60rem) 44rem, 100vw"
					loading="eager"
					fetchpriority="high"
					class="hero"
				/>
			)
		}

		<div class="rail cuerpo">
			<div>
				<TableOfContents headings={headings} variant="riel" />
			</div>
			<div>
				<TableOfContents headings={headings} variant="movil" />
				<div class="prose prose-article max-w-none">
					<slot />
				</div>
			</div>
		</div>

		<div class="rail">
			<div aria-hidden="true"></div>
			<div>
				<AdSlot placement="article" minHeight={280} />

				{
					related.length > 0 && (
						<section class="rule-t relacionados" aria-labelledby="relacionados">
							<h2 id="relacionados" class="relacionados-titulo">
								{relatedMixed ? 'Seguí leyendo' : `Seguí leyendo sobre ${clusterMeta.short.toLowerCase()}`}
							</h2>
							{related.map((item) => (
								<ArticleRow article={item} showCluster={relatedMixed} />
							))}
						</section>
					)
				}

				<AuthorBox author={author} />
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.miga {
		padding-block: 1.25rem;
	}

	.cabecera {
		padding-top: 2.5rem;
		padding-bottom: 2.5rem;
	}

	.riel > * {
		display: block;
	}

	.riel > * + * {
		margin-top: 0.25rem;
	}

	.autor-link {
		text-decoration: none;
	}

	.autor-link:hover {
		color: var(--tinta);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.bajada {
		margin-top: 1.25rem;
		color: var(--grafito);
		font-size: 1.125rem;
		max-width: 40rem;
	}

	.hero {
		width: 100%;
		margin-block: 2rem;
		border: 1px solid var(--regla);
	}

	.cuerpo {
		padding-bottom: 2rem;
	}

	.relacionados {
		margin-top: 3rem;
		padding-top: 2rem;
	}

	.relacionados-titulo {
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--grafito);
		margin-bottom: 0.5rem;
	}
</style>
