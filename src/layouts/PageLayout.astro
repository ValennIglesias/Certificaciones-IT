---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
	title: string;
	description: string;
	heading?: string;
	updated?: string;
}

const { title, description, heading, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<div class="wrap pagina">
		<div class="miga">
			<Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: heading ?? title }]} />
		</div>

		<header class="cabecera rule-t">
			<h1 class="title">{heading ?? title}</h1>
			{updated && <p class="meta figure act">Última actualización: {updated}</p>}
		</header>

		<div class="prose prose-article max-w-none">
			<slot />
		</div>
	</div>
</BaseLayout>

<style>
	.pagina {
		max-width: 48rem;
	}

	.miga {
		padding-block: 1.25rem;
	}

	.cabecera {
		padding-block: 2.5rem;
	}

	.act {
		margin-top: 0.75rem;
	}
</style>
