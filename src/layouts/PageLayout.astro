---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
	title: string;
	description: string;
	heading?: string;
	updated?: string;
}

const { title, description, heading, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<div class="mx-auto max-w-3xl px-4 py-8">
		<Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: heading ?? title }]} />

		<h1 class="mt-6 text-3xl font-black tracking-tight text-app sm:text-4xl">{heading ?? title}</h1>
		{updated && <p class="mt-2 text-sm text-app-muted">Última actualización: {updated}</p>}

		<div class="prose prose-article mt-8 max-w-none">
			<slot />
		</div>
	</div>
</BaseLayout>
