---
import '../styles/global.css';
import { SITE, CLUSTERS, type ClusterId } from '../consts';
import SEO from '../components/SEO.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	publishedTime?: Date;
	modifiedTime?: Date;
	author?: string;
	section?: string;
	useTitleTemplate?: boolean;
	/** Cluster de la página. Define el único acento visible. Sin esto, acromática. */
	accent?: ClusterId;
}

const { accent, ...props } = Astro.props;

// Un acento por página: se inyectan los tres valores del cluster y el CSS
// elige cuál usar según el tema. Sin cluster, las variables no existen y
// el sistema cae a tinta.
const meta = accent ? CLUSTERS[accent] : null;
const accentVars = meta
	? `--accent-l:${meta.accent};--accent-ink-l:${meta.accentInk};--accent-d:${meta.accentDark}`
	: undefined;
---

<!doctype html>
<html lang={SITE.lang} style={accentVars}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />

		<SEO {...props} />
		<Analytics />

		{/* Antes del primer pintado, para que no haya flash de tema incorrecto. */}
		<script is:inline>
			(function () {
				try {
					var t = localStorage.getItem('cit:theme');
					if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
				} catch (e) {}
			})();
		</script>

		<slot name="head" />
	</head>

	<body>
		<a href="#contenido" class="skip-link">Saltar al contenido</a>
		<Header />

		<main id="contenido">
			<slot />
		</main>

		<Footer />
		<ConsentBanner />
	</body>
</html>
