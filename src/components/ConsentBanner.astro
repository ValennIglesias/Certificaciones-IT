---
/**
 * Banner de consentimiento de cookies. Va al final del <body>.
 *
 * Cómo funciona:
 *  1. Analytics.astro ya dejó Consent Mode v2 en "denied" en el <head>.
 *  2. Este componente NO emite ningún <script src> de Google en el HTML. (El de
 *     AdSense lo pone Analytics.astro en el <head>, después de Consent Mode.)
 *     Los scripts de GA4 y AdSense se crean con createElement y se insertan en
 *     el DOM recién cuando el usuario acepta (o en cargas posteriores, si ya
 *     había aceptado antes). Si rechaza, nunca entran al DOM.
 *  3. La decisión se guarda en localStorage y el banner no vuelve a aparecer,
 *     salvo que se use el botón "Cookies" del footer.
 *  4. Convive con la CMP de Google (Privacidad y mensajes de AdSense). Antes de
 *     mostrarse, espera hasta 2 s la API de TCF (__tcfapi). Si la CMP responde
 *     que el visitante está alcanzado por el RGPD (gdprApplies === true: EEE,
 *     Reino Unido, Suiza), este banner NO aparece y no toca Consent Mode: el
 *     consentimiento de esa persona lo maneja la CMP de Google. En cualquier
 *     otro caso (sin __tcfapi, gdprApplies false o no booleano, error) el
 *     banner funciona exactamente igual que antes. Mientras el mensaje de
 *     Google no esté publicado, no hay __tcfapi y todos ven este banner.
 *
 * Sin librerías: son ~40 líneas de JS inline, sin request adicional.
 * Si no hay GA ni AdSense configurados, no se renderiza nada.
 */
import {
	GA_ID,
	ADSENSE_CLIENT,
	ADSENSE_ENABLED,
	CONSENT_REQUIRED,
	CONSENT_STORAGE_KEY,
	adSlotFor,
} from '../lib/analytics';

const config = {
	ga: GA_ID,
	ads: ADSENSE_ENABLED ? ADSENSE_CLIENT : '',
	/** Bloque para los anuncios dentro del cuerpo (marcadores de ad-anchors-plugin). */
	inlineSlot: adSlotFor('article') ?? '',
	key: CONSENT_STORAGE_KEY,
};
---

{
	CONSENT_REQUIRED && (
		<>
			{/*
			  hidden de entrada: el JS lo muestra solo si no hay decisión guardada.
			  Así quien ya decidió no ve ningún parpadeo, y quien tiene JS desactivado
			  no ve el banner — correcto, porque sin JS tampoco se carga nada de Google.
			  Al ser position:fixed no desplaza contenido: no genera CLS.
			*/}
			<div id="cookie-consent" hidden role="region" aria-label="Consentimiento de cookies">
				<div class="cc-caja">
					<div class="cc-texto">
						<p class="cc-titulo">Cookies en este sitio</p>
						<p class="cc-cuerpo">
							Usamos cookies de Google Analytics para medir el tráfico y de Google AdSense para
							mostrar publicidad. No se activan si no las aceptás.{' '}
							<a href="/politica-de-cookies/">Política de cookies</a>.
						</p>
					</div>

					<div class="cc-botones">
						<button type="button" data-consent="denied" class="cc-boton">Rechazar</button>
						<button type="button" data-consent="granted" class="cc-boton cc-boton--si">Aceptar</button>
					</div>
				</div>
			</div>

			<script is:inline define:vars={{ config }}>
				(function () {
					var banner = document.getElementById('cookie-consent');
					var loaded = false;

					function read() {
						try {
							return localStorage.getItem(config.key);
						} catch (e) {
							return null; /* modo privado o storage bloqueado */
						}
					}

					function save(value) {
						try {
							localStorage.setItem(config.key, value);
						} catch (e) {
							/* si no se puede guardar, se volverá a preguntar: es el lado seguro */
						}
					}

					/* true cuando el banner cedió ante la CMP de Google para este visitante. */
					var cedido = false;
					var analyticsLoaded = false;
					var adsLoaded = false;

					/* Inserta los scripts de Google en el DOM. Solo se llama con consentimiento. */
					function loadGoogle() {
						if (loaded) return;
						loaded = true;
						loadAnalytics();
						loadAds();
					}

					function loadAnalytics() {
						if (analyticsLoaded) return;
						analyticsLoaded = true;

						if (config.ga) {
							var ga = document.createElement('script');
							ga.async = true;
							ga.src = 'https://www.googletagmanager.com/gtag/js?id=' + config.ga;
							document.head.appendChild(ga);
							gtag('js', new Date());
							gtag('config', config.ga);
						}
					}

					function loadAds() {
						if (adsLoaded) return;
						adsLoaded = true;

						/*
						  El script de AdSense ya está en el <head> (Analytics.astro). Acá solo
						  se crean y se llenan los bloques de anuncios, y solo si la cuenta
						  está aprobada (config.ads vacío mientras PUBLIC_ADSENSE_ENABLED no
						  sea "true").
						*/
						if (config.ads) {
							/*
							  Anuncios dentro del cuerpo: el CSS ya les reservó la altura a los
							  marcadores visibles (clase con-anuncios); acá se crea el <ins>.
							*/
							if (config.inlineSlot) {
								var anchors = document.querySelectorAll('.con-anuncios [data-ad-anchor]');
								for (var j = 0; j < anchors.length; j++) {
									var ins = document.createElement('ins');
									ins.className = 'adsbygoogle';
									ins.style.display = 'block';
									ins.style.minHeight = '280px';
									ins.setAttribute('data-ad-client', config.ads);
									ins.setAttribute('data-ad-slot', config.inlineSlot);
									ins.setAttribute('data-ad-format', 'auto');
									ins.setAttribute('data-full-width-responsive', 'true');
									anchors[j].appendChild(ins);
								}
							}

							/* Un push por cada hueco de anuncio presente en la página. */
							window.adsbygoogle = window.adsbygoogle || [];
							var slots = document.querySelectorAll('ins.adsbygoogle');
							for (var i = 0; i < slots.length; i++) window.adsbygoogle.push({});
						}
					}

					function updateConsent(state) {
						gtag('consent', 'update', {
							ad_storage: state,
							ad_user_data: state,
							ad_personalization: state,
							analytics_storage: state,
						});
					}

					function accept() {
						updateConsent('granted');
						loadGoogle();
					}

					/* Borra las cookies que hubieran quedado de una aceptación anterior. */
					function clearGoogleCookies() {
						var names = document.cookie.split(';');
						for (var i = 0; i < names.length; i++) {
							var name = names[i].split('=')[0].trim();
							if (name.indexOf('_ga') === 0 || name.indexOf('_gcl') === 0) {
								document.cookie =
									name + '=; Max-Age=0; path=/; domain=.' + location.hostname;
								document.cookie = name + '=; Max-Age=0; path=/';
							}
						}
					}

					function decide(value) {
						save(value);
						banner.hidden = true;

						if (value === 'granted') {
							accept();
							return;
						}

						updateConsent('denied');
						clearGoogleCookies();

						/*
						  Si el usuario había aceptado antes, los scripts ya están en esta
						  página. Consent Mode corta el uso de cookies, pero la única forma
						  de dejar la página realmente limpia es recargarla: al volver a
						  cargar, la decisión guardada es 'denied' y no se inyecta nada.
						*/
						if (loaded) location.reload();
					}

					banner.addEventListener('click', function (event) {
						var button = event.target.closest('[data-consent]');
						if (button) decide(button.getAttribute('data-consent'));
					});

					/* Botón "Cookies" del footer: permite revisar la decisión cuando se quiera. */
					document.addEventListener('click', function (event) {
						if (event.target.closest('[data-consent-reopen]')) {
							/*
							  Visitante europeo: las preferencias son las de la CMP de Google.
							  Se reabre su mensaje con la API oficial (googlefc), no este banner.
							*/
							if (cedido) {
								window.googlefc = window.googlefc || {};
								window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
								window.googlefc.callbackQueue.push(function () {
									window.googlefc.showRevocationMessage();
								});
								return;
							}
							banner.hidden = false;
							banner.querySelector('[data-consent]').focus();
						}
					});

					/*
					  TCF: consentimiento para "almacenar o acceder a información en el
					  dispositivo" (propósito 1). Con eso se carga GA para el visitante
					  europeo; Consent Mode lo actualiza la CMP de Google, no este banner.
					*/
					function consintioAlmacenamiento(tcData) {
						return (
							(tcData.eventStatus === 'tcloaded' || tcData.eventStatus === 'useractioncomplete') &&
							!!tcData.purpose &&
							!!tcData.purpose.consents &&
							tcData.purpose.consents[1] === true
						);
					}

					/*
					  Llama a done(true) solo si la CMP de Google responde ok con
					  gdprApplies === true. Cualquier otra cosa (sin __tcfapi en 2 s,
					  ok false, gdprApplies false o no booleano, error) es done(false).
					*/
					function consultarCmpDeGoogle(done) {
						var limite = Date.now() + 2000;
						var terminado = false;

						function fin(ceder) {
							if (terminado) return;
							terminado = true;
							done(ceder);
						}

						function escuchar() {
							try {
								window.__tcfapi('addEventListener', 2, function (tcData, ok) {
									fin(ok === true && !!tcData && tcData.gdprApplies === true);
									if (cedido && ok === true && tcData && consintioAlmacenamiento(tcData)) {
										loadAnalytics();
									}
								});
							} catch (e) {
								fin(false);
							}
						}

						(function esperar() {
							if (terminado) return;
							if (typeof window.__tcfapi === 'function') return escuchar();
							if (Date.now() >= limite) return fin(false);
							setTimeout(esperar, 50);
						})();

						/* Si __tcfapi aparece pero nunca contesta, no se espera más de 2 s. */
						setTimeout(function () {
							fin(false);
						}, 2000);
					}

					var stored = read();
					consultarCmpDeGoogle(function (ceder) {
						if (ceder) {
							/*
							  La CMP de Google maneja el consentimiento: no se muestra el banner,
							  no se llama a gtag('consent', 'update') ni se aplica una decisión
							  guardada antes. Los bloques de anuncios se cargan igual: con TCF,
							  Google decide qué anuncio servir según el consentimiento.
							*/
							cedido = true;
							loadAds();
							return;
						}
						if (stored === 'granted') accept();
						else if (stored !== 'denied') banner.hidden = false;
					});
				})();
			</script>
		</>
	)
}

<style>
	#cookie-consent {
		position: fixed;
		inset-inline: 0;
		bottom: 0;
		z-index: 50;
		background-color: var(--papel);
		border-top: 1px solid var(--tinta);
	}

	.cc-caja {
		max-width: 68rem;
		margin-inline: auto;
		padding: 1.25rem;
		display: grid;
		gap: 1rem;
		align-items: center;
	}

	@media (min-width: 48rem) {
		.cc-caja {
			grid-template-columns: minmax(0, 1fr) auto;
		}
	}

	.cc-titulo {
		font-weight: 700;
		font-size: 0.9375rem;
	}

	.cc-cuerpo {
		margin-top: 0.25rem;
		font-size: 0.875rem;
		color: var(--grafito);
		max-width: 46rem;
	}

	.cc-cuerpo a {
		color: var(--tinta);
	}

	.cc-botones {
		display: flex;
		gap: 0.75rem;
	}

	/* Rechazar y aceptar: mismo tamaño, mismo peso, un solo clic cada uno. */
	.cc-boton {
		font: inherit;
		font-size: 0.875rem;
		font-weight: 700;
		padding: 0.625rem 1.25rem;
		border: 1px solid var(--tinta);
		background-color: var(--papel);
		color: var(--tinta);
		cursor: pointer;
		flex: 1 1 auto;
	}

	.cc-boton--si {
		background-color: var(--tinta);
		color: var(--papel);
	}

	.cc-boton:hover {
		opacity: 0.85;
	}
</style>
