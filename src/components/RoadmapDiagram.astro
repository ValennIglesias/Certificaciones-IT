---
/**
 * Mapa de las cuatro rutas de certificación, en tres etapas.
 *
 * Es HTML real, no una imagen: se lee, se selecciona, lo indexa Google y
 * hereda el tema. Semánticamente es una tabla —rutas por etapas— con
 * encabezados de fila, que es lo que un lector de pantalla necesita.
 *
 * El dato que agrega sobre la tabla de detalle: distingue las etapas que se
 * cubren con una certificación de las que se cubren con experiencia en el
 * puesto. Esa es la tesis del artículo y en una tabla de texto se pierde.
 *
 * Usa el acento de la página (carrera), no un color por ruta: el sistema es
 * un acento por página.
 */

type Etapa = { texto: string; experiencia?: boolean };

const ETAPAS = ['Base', 'Intermedio', 'Especialización'];

const RUTAS: { ruta: string; pasos: Etapa[] }[] = [
	{
		ruta: 'Soporte → Infraestructura',
		pasos: [
			{ texto: 'CompTIA A+ o ITIL Foundation' },
			{ texto: 'Experiencia con Active Directory y ITSM', experiencia: true },
			{ texto: 'Certificación de infraestructura o formación formal' },
		],
	},
	{
		ruta: 'Redes',
		pasos: [
			{ texto: 'Cisco CCST Networking o CompTIA Network+' },
			{ texto: 'Cisco CCNA' },
			{ texto: 'Especialización Cisco (CCNP)' },
		],
	},
	{
		ruta: 'Seguridad',
		pasos: [
			{ texto: 'CompTIA Security+' },
			{ texto: 'CompTIA CySA+ o CCNA Cybersecurity' },
			{ texto: 'CISSP, pentesting o GRC' },
		],
	},
	{
		ruta: 'Cloud',
		pasos: [
			{ texto: 'AWS Cloud Practitioner o Azure AZ-900' },
			{ texto: 'AWS Solutions Architect o AZ-104' },
			{ texto: 'Certificación profesional del proveedor' },
		],
	},
];
---

<figure class="mapa">
	<table>
		<caption>Las cuatro rutas de certificación y sus tres etapas.</caption>
		<thead>
			<tr>
				<th scope="col"><span class="oculto">Ruta</span></th>
				{
					ETAPAS.map((etapa, i) => (
						<th scope="col">
							<span class="etapa-n">{i + 1}</span>
							<span class="etapa-t">{etapa}</span>
						</th>
					))
				}
			</tr>
		</thead>
		<tbody>
			{
				RUTAS.map(({ ruta, pasos }) => (
					<tr>
						<th scope="row">{ruta}</th>
						{pasos.map((paso) => (
							<td class:list={[paso.experiencia && 'es-experiencia']}>
								<span class="nodo" aria-hidden="true" />
								{paso.texto}
							</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>

	<figcaption>
		<span class="ref"><span class="nodo" aria-hidden="true"></span> Se cubre con una certificación</span>
		<span class="ref"><span class="nodo nodo--hueco" aria-hidden="true"></span> Se cubre con experiencia en el puesto</span>
	</figcaption>
</figure>

<style>
	.mapa {
		margin: 2.5rem 0 3rem;
	}

	.mapa table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
		line-height: 1.4;
	}

	/* El diagrama no es una tabla de spec: acá todo se alinea a la izquierda,
	   aunque esté dentro del contenedor de prosa. */
	.mapa th,
	.mapa td {
		text-align: left;
	}

	.mapa caption {
		text-align: left;
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--grafito);
		padding-bottom: 0.75rem;
	}

	.mapa thead th {
		text-align: left;
		padding: 0 0 0.75rem;
		border-bottom: 2px solid var(--tinta);
		vertical-align: bottom;
	}

	.etapa-n {
		display: block;
		font-variant-numeric: tabular-nums;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1;
		color: var(--accent-ink);
	}

	.etapa-t {
		display: block;
		margin-top: 0.25rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--grafito);
	}

	.mapa tbody th {
		text-align: left;
		font-weight: 700;
		padding: 1rem 1.25rem 1rem 0;
		border-bottom: 1px solid var(--regla);
		vertical-align: top;
		width: 11rem;
	}

	.mapa tbody td {
		padding: 1rem 1.25rem 1rem 0;
		border-bottom: 1px solid var(--regla);
		vertical-align: top;
	}

	.mapa tbody tr:last-child th,
	.mapa tbody tr:last-child td {
		border-bottom: 0;
	}

	/* Nodo lleno: certificación. Hueco: experiencia. La distinción también
	   está en el texto de la celda, no solo en la forma. */
	.nodo {
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.5rem;
		background-color: var(--accent);
		vertical-align: 0.05rem;
	}

	.es-experiencia .nodo,
	.nodo--hueco {
		background-color: transparent;
		box-shadow: inset 0 0 0 1.5px var(--accent);
	}

	.mapa figcaption {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		padding-top: 1rem;
		font-size: 0.8125rem;
		color: var(--grafito);
	}

	.oculto {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	/* En pantallas chicas la tabla se reordena: cada ruta es un bloque y las
	   tres etapas se apilan, en vez de obligar a scrollear en horizontal. */
	@media (max-width: 47.99rem) {
		.mapa thead {
			display: none;
		}

		/* Con la tabla en display:block el caption se encoge; hay que soltarlo. */
		.mapa caption {
			display: block;
			width: 100%;
		}

		.mapa table,
		.mapa tbody,
		.mapa tr,
		.mapa tbody th,
		.mapa tbody td {
			display: block;
			width: auto;
		}

		.mapa tbody tr {
			padding-block: 1rem;
			border-bottom: 1px solid var(--regla);
		}

		.mapa tbody tr:last-child {
			border-bottom: 0;
		}

		.mapa tbody th {
			padding: 0 0 0.5rem;
			border-bottom: 0;
			font-size: 1rem;
		}

		.mapa tbody td {
			padding: 0.25rem 0 0.25rem 0;
			border-bottom: 0;
		}

		.mapa tbody td::after {
			content: ' — etapa ' counter(etapa);
			color: var(--grafito);
		}

		.mapa tbody tr {
			counter-reset: etapa;
		}

		.mapa tbody td {
			counter-increment: etapa;
		}
	}
</style>
