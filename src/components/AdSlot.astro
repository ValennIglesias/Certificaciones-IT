---
import { adSlotFor, AD_SLOT_ENV_VAR, ADSENSE_ENABLED, ADSENSE_CLIENT, type AdPlacement } from '../lib/analytics';

/**
 * Bloque de anuncios de AdSense.
 *
 * No recibe el id del bloque: recibe la UBICACIÓN ("article", "category",
 * "home") y el id sale de la variable de entorno correspondiente. Así no hay
 * ids hardcodeados en las páginas ni riesgo de publicar un placeholder.
 *
 * Falla cerrado: si AdSense está apagado, o si falta el id, o si el id sigue
 * siendo un placeholder tipo "0000000000", no se renderiza NADA — ni el
 * anuncio ni el hueco reservado. Mejor que quede el contenido junto a que
 * aparezca una franja vacía o un anuncio roto.
 *
 * El <ins> es solo un contenedor: no carga nada ni instala cookies por sí
 * mismo. Quien lo llena es ConsentBanner.astro, que inyecta el script de
 * AdSense y hace el push de cada hueco recién cuando hay consentimiento.
 */
interface Props {
	/** Dónde va este bloque. Determina qué variable de entorno se usa. */
	placement: AdPlacement;
	format?: string;
	/** Altura mínima reservada, en px. Evita el salto de layout al cargar. */
	minHeight?: number;
	label?: string;
	class?: string;
}

const {
	placement,
	format = 'auto',
	minHeight = 280,
	label = 'Publicidad',
	class: className = '',
} = Astro.props;

const slot = adSlotFor(placement);
const isDev = import.meta.env.DEV;

/** Por qué no se muestra el anuncio. Solo se usa para el aviso en desarrollo. */
const devReason = !ADSENSE_ENABLED
	? 'PUBLIC_ADSENSE_ENABLED no es "true"'
	: `falta ${AD_SLOT_ENV_VAR[placement]} (o sigue en un placeholder)`;
---

{
	slot ? (
		<aside
			class:list={['my-8 w-full', className]}
			style={`min-height:${minHeight}px`}
			aria-label={label}>
			<p class="mb-1 text-center text-[11px] uppercase tracking-widest text-app-muted">{label}</p>
			<ins
				class="adsbygoogle block"
				style={`display:block;min-height:${minHeight}px`}
				data-ad-client={ADSENSE_CLIENT}
				data-ad-slot={slot}
				data-ad-format={format}
				data-full-width-responsive="true"
			/>
		</aside>
	) : isDev ? (
		<aside class:list={['my-8 w-full', className]} aria-hidden="true">
			<div
				class="flex w-full flex-col items-center justify-center gap-1 rounded-lg border border-dashed border-app p-4 text-center text-xs text-app-muted"
				style={`min-height:${minHeight}px`}>
				<span class="font-semibold">Hueco de AdSense — ubicación «{placement}»</span>
				<span>No se renderiza en producción: {devReason}.</span>
			</div>
		</aside>
	) : null
}
