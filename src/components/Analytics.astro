---
/**
 * Va en el <head>. NO carga ningún script de Google: solo deja preparado el
 * dataLayer y fija Consent Mode v2 en "denied" antes de que exista cualquier
 * etiqueta. La carga real de GA4 y AdSense la hace ConsentBanner.astro, recién
 * cuando el usuario acepta.
 *
 * El shim de gtag() es código propio de dos líneas: encola llamadas en un array.
 * No hace requests ni instala cookies, así que puede ejecutarse antes del
 * consentimiento — de hecho DEBE hacerlo, porque el estado "denied" por defecto
 * tiene que estar en la cola antes de que gtag.js se cargue.
 *
 * Variables: ver .env.example.
 */
import { GA_ID, GSC_VERIFICATION, ADSENSE_CLIENT, ADSENSE_ENABLED, CONSENT_REQUIRED } from '../lib/analytics';
---

{/* Verificación de Search Console: es un meta tag, no instala cookies. */}
{GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

{/*
  Verificación del sitio en AdSense: otro meta tag, sin cookies ni scripts. Sale
  apenas se carga PUBLIC_ADSENSE_CLIENT, aunque AdSense siga apagado, porque Google
  lo busca durante la revisión de la cuenta, antes de la aprobación.
*/}
{ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}

{
	CONSENT_REQUIRED && (
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				window.dataLayer.push(arguments);
			}
			window.gtag = gtag;

			/* Consent Mode v2: todo denegado hasta que el usuario decida. */
			gtag('consent', 'default', {
				ad_storage: 'denied',
				ad_user_data: 'denied',
				ad_personalization: 'denied',
				analytics_storage: 'denied',
				functionality_storage: 'granted',
				security_storage: 'granted',
			});
		</script>
	)
}

{
	/*
	  Preconnect solo a los orígenes que se van a usar si hay consentimiento.
	  No descarga nada ni instala cookies; ahorra el handshake si el usuario acepta.
	*/
	GA_ID && <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
}
{ADSENSE_ENABLED && <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />}
