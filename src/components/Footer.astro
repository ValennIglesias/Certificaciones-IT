---
import { SITE, CLUSTERS, CLUSTER_IDS } from '../consts';
import { CONSENT_REQUIRED } from '../lib/analytics';
const year = new Date().getFullYear();
---

<footer class="rule-t pie">
	<div class="wrap pie-grid">
		<div>
			<p class="pie-marca">{SITE.name}</p>
			<p class="meta pie-desc">{SITE.description}</p>
		</div>

		<nav aria-label="Categorías del sitio">
			<p class="pie-titulo">Categorías</p>
			<ul class="pie-lista">
				{
					CLUSTER_IDS.map((id) => (
						<li>
							<a href={`/${id}/`}>{CLUSTERS[id].name}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<nav aria-label="Enlaces legales">
			<p class="pie-titulo">El sitio</p>
			<ul class="pie-lista">
				<li><a href="/sobre-nosotros/">Sobre nosotros</a></li>
				<li><a href="/politica-de-privacidad/">Política de privacidad</a></li>
				<li><a href="/sitemap-index.xml">Sitemap</a></li>
				{
					CONSENT_REQUIRED && (
						<li>
							<button type="button" data-consent-reopen class="pie-boton">
								Preferencias de cookies
							</button>
						</li>
					)
				}
			</ul>
		</nav>
	</div>

	<div class="wrap rule-t pie-legal">
		<p class="meta">
			© {year} {SITE.name}. Contenido informativo; los nombres de certificaciones y sus marcas
			pertenecen a sus respectivos titulares.
		</p>
	</div>
</footer>

<style>
	.pie {
		margin-top: 5rem;
	}

	.pie-grid {
		display: grid;
		gap: 2.5rem;
		padding-block: 3rem;
	}

	@media (min-width: 48rem) {
		.pie-grid {
			grid-template-columns: minmax(0, 1.4fr) 1fr 1fr;
		}
	}

	.pie-marca {
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.pie-desc {
		margin-top: 0.5rem;
		max-width: 32rem;
	}

	.pie-titulo {
		font-weight: 700;
		font-size: 0.9375rem;
	}

	.pie-lista {
		margin-top: 0.75rem;
		display: grid;
		gap: 0.375rem;
		font-size: 0.9375rem;
	}

	.pie-lista a,
	.pie-boton {
		color: var(--grafito);
		text-decoration: none;
	}

	.pie-lista a:hover,
	.pie-boton:hover {
		color: var(--tinta);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.pie-boton {
		font: inherit;
		background: none;
		border: 0;
		padding: 0;
		cursor: pointer;
		text-align: left;
	}

	.pie-legal {
		padding-block: 1.25rem;
	}
</style>
