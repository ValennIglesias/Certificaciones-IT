---
import { SITE, CLUSTERS, CLUSTER_IDS } from '../consts';
import { CONSENT_REQUIRED } from '../lib/analytics';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-app surface-muted">
	<div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:grid-cols-3">
		<div>
			<p class="font-bold text-app">{SITE.name}</p>
			<p class="mt-2 text-sm text-app-muted">{SITE.description}</p>
		</div>

		<nav aria-label="Categorías del sitio">
			<p class="text-sm font-semibold text-app">Categorías</p>
			<ul class="mt-2 space-y-1 text-sm">
				{
					CLUSTER_IDS.map((id) => (
						<li>
							<a href={`/${id}/`} class="text-app-muted hover:text-brand-600">
								{CLUSTERS[id].name}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<nav aria-label="Enlaces legales">
			<p class="text-sm font-semibold text-app">El sitio</p>
			<ul class="mt-2 space-y-1 text-sm">
				<li>
					<a href="/sobre-nosotros/" class="text-app-muted hover:text-brand-600">Sobre nosotros</a>
				</li>
				<li>
					<a href="/politica-de-privacidad/" class="text-app-muted hover:text-brand-600">
						Política de privacidad
					</a>
				</li>
				<li>
					<a href="/sitemap-index.xml" class="text-app-muted hover:text-brand-600">Sitemap</a>
				</li>
				{
					/* Permite revisar la decisión de cookies en cualquier momento.
					   ConsentBanner.astro engancha el click por [data-consent-reopen]. */
					CONSENT_REQUIRED && (
						<li>
							<button
								type="button"
								data-consent-reopen
								class="text-app-muted underline-offset-2 hover:text-brand-600 hover:underline">
								Preferencias de cookies
							</button>
						</li>
					)
				}
			</ul>
		</nav>
	</div>

	<div class="border-t border-app">
		<p class="mx-auto max-w-5xl px-4 py-4 text-xs text-app-muted">
			© {year} {SITE.name}. Contenido informativo; los nombres de certificaciones y sus marcas
			pertenecen a sus respectivos titulares.
		</p>
	</div>
</footer>
