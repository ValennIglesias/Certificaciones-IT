---
import { Image } from 'astro:assets';
import { CLUSTERS, type ClusterId } from '../consts';
import { articlePath, formatDate, type Article } from '../lib/articles';

interface Props {
	article: Article;
	/** La primera tarjeta de la home se muestra más grande. */
	featured?: boolean;
}

const { article, featured = false } = Astro.props;
const { title, description, cluster, pubDate, draft, heroImage, heroAlt } = article.data;
const href = articlePath(article);
const clusterName = CLUSTERS[cluster as ClusterId].name;
---

<article
	class:list={[
		'group relative flex flex-col overflow-hidden rounded-xl border border-app surface transition-shadow hover:shadow-md',
		featured && 'sm:col-span-2 sm:flex-row',
	]}>
	{
		heroImage && (
			<div class:list={['shrink-0 overflow-hidden', featured ? 'sm:w-2/5' : '']}>
				<Image
					src={heroImage}
					alt={heroAlt ?? ''}
					widths={[400, 800]}
					sizes={featured ? '(min-width: 640px) 40vw, 100vw' : '(min-width: 640px) 33vw, 100vw'}
					loading={featured ? 'eager' : 'lazy'}
					class="h-40 w-full object-cover sm:h-full"
				/>
			</div>
		)
	}

	<div class="flex flex-1 flex-col p-5">
		<div class="flex items-center gap-2 text-xs">
			<span class="rounded-full bg-brand-50 px-2 py-0.5 font-medium text-brand-700 dark:bg-brand-900 dark:text-brand-200">
				{clusterName}
			</span>
			{draft && (
				<span class="rounded-full bg-accent-400/20 px-2 py-0.5 font-medium text-accent-600">
					Borrador
				</span>
			)}
			<time datetime={pubDate.toISOString()} class="text-app-muted">{formatDate(pubDate)}</time>
		</div>

		<h2 class:list={['mt-2 font-bold leading-snug text-app', featured ? 'text-xl sm:text-2xl' : 'text-lg']}>
			<a href={href} class="after:absolute after:inset-0 hover:text-brand-600">{title}</a>
		</h2>

		<p class="mt-2 line-clamp-3 text-sm text-app-muted">{description}</p>
	</div>
</article>
