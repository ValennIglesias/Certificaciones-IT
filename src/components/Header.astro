---
import { SITE, NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

// Navegación sin JavaScript: en mobile la barra de clusters scrollea en
// horizontal en vez de esconderse detrás de un menú hamburguesa.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="rule-b">
	<div class="wrap header-bar">
		<a href="/" class="marca">{SITE.name}</a>

		<nav aria-label="Categorías" class="nav">
			{
				NAV_LINKS.map((link) => (
					<a
						href={link.href}
						aria-current={isActive(link.href) ? 'page' : undefined}
						class:list={['nav-link', isActive(link.href) && 'nav-link--activo']}>
						{link.label}
					</a>
				))
			}
		</nav>

		<ThemeToggle />
	</div>
</header>

<style>
	.header-bar {
		display: flex;
		align-items: baseline;
		gap: 1.5rem;
		padding-block: 1.125rem;
		flex-wrap: wrap;
	}

	.marca {
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: -0.02em;
		text-decoration: none;
		color: var(--tinta);
	}

	.nav {
		display: flex;
		gap: 1.25rem;
		margin-right: auto;
		overflow-x: auto;
		scrollbar-width: none;
		font-size: 0.9375rem;
	}

	.nav::-webkit-scrollbar {
		display: none;
	}

	.nav-link {
		color: var(--grafito);
		text-decoration: none;
		white-space: nowrap;
	}

	.nav-link:hover {
		color: var(--tinta);
	}

	.nav-link--activo {
		color: var(--accent-ink);
		font-weight: 700;
	}
</style>
