---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getArticles, getRelatedArticles, articleSlug, avisarPendientes } from '../../lib/articles';

export const getStaticPaths = (async () => {
	const articles = await getArticles();
	avisarPendientes(articles);
	return articles.map((article) => ({
		params: { cluster: article.data.cluster, slug: articleSlug(article) },
		props: { article },
	}));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const { Content } = await render(article);
const related = await getRelatedArticles(article);
---

<ArticleLayout article={article} related={related}>
	<Content />
</ArticleLayout>
