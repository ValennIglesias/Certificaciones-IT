---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import { CLUSTERS, CLUSTER_IDS, type ClusterId } from '../../consts';
import { getArticles } from '../../lib/articles';

export const getStaticPaths = (() =>
	CLUSTER_IDS.map((cluster) => ({ params: { cluster } }))) satisfies GetStaticPaths;

const cluster = Astro.params.cluster as ClusterId;
const meta = CLUSTERS[cluster];
const articles = await getArticles(cluster);
---

<BaseLayout
	title={meta.name}
	description={meta.description}
	accent={cluster}
	image={`/og/cluster-${cluster}.jpg`}
	imageAlt={meta.name}>
	<div class="wrap">
		<div class="miga">
			<Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: meta.name }]} />
		</div>

		<header class="cabecera rule-t">
			<h1 class="title">{meta.name}</h1>
			<div class="cabecera-pie">
				<p class="bajada">{meta.description}</p>
				<p class="total figure">
					{articles.length}
					<span>{articles.length === 1 ? 'guía' : 'guías'}</span>
				</p>
			</div>
		</header>

		<p class="intro" set:html={meta.intro} />

		{
			articles.length === 0 ? (
				<p class="vacio rule-t">Todavía no hay artículos en esta categoría.</p>
			) : (
				articles.map((article) => <ArticleRow article={article} showCluster={false} />)
			)
		}

		<AdSlot placement="category" minHeight={280} />
	</div>
</BaseLayout>

<style>
	.miga {
		padding-block: 1.25rem;
	}

	.cabecera {
		padding-block: 2.5rem;
	}

	.cabecera-pie {
		display: grid;
		gap: 1.25rem;
		margin-top: 1.25rem;
		align-items: start;
	}

	@media (min-width: 48rem) {
		.cabecera-pie {
			grid-template-columns: minmax(0, 40rem) auto;
			justify-content: space-between;
		}
	}

	.intro {
		max-width: 40rem;
		padding-bottom: 2rem;
		font-size: 1.0625rem;
	}

	.intro :global(a) {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.bajada {
		color: var(--grafito);
		font-size: 1.0625rem;
		max-width: 40rem;
	}

	.total {
		font-weight: 700;
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 0.9;
		letter-spacing: -0.04em;
		color: var(--accent-ink);
	}

	.total span {
		display: block;
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0;
		color: var(--grafito);
		margin-top: 0.375rem;
	}

	.vacio {
		padding-block: 3rem;
		color: var(--grafito);
	}
</style>
