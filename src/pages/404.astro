---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CLUSTERS, CLUSTER_IDS } from '../consts';
---

<BaseLayout
	title="Página no encontrada"
	description="La página que buscás no existe o cambió de dirección."
	noindex>
	<div class="mx-auto max-w-3xl px-4 py-20 text-center">
		<p class="text-sm font-bold uppercase tracking-widest text-brand-600 dark:text-brand-300">
			Error 404
		</p>
		<h1 class="mt-3 text-3xl font-black tracking-tight text-app sm:text-4xl">
			Esta página no existe
		</h1>
		<p class="mt-4 text-app-muted">
			Puede que el enlace esté roto o que el artículo haya cambiado de dirección. Probá con una
			categoría:
		</p>

		<div class="mt-8 flex flex-wrap justify-center gap-2">
			{
				CLUSTER_IDS.map((id) => (
					<a
						href={`/${id}/`}
						class="rounded-lg border border-app surface px-4 py-2 text-sm font-medium text-app hover:border-brand-400 hover:text-brand-600">
						{CLUSTERS[id].short}
					</a>
				))
			}
		</div>

		<p class="mt-8">
			<a href="/" class="font-medium text-brand-600 hover:underline dark:text-brand-300">
				Volver al inicio
			</a>
		</p>
	</div>
</BaseLayout>
