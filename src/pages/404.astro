---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CLUSTERS, CLUSTER_IDS } from '../consts';
---

<BaseLayout
	title="Página no encontrada"
	description="La página que buscás no existe o cambió de dirección."
	noindex>
	<div class="wrap error">
		<p class="codigo figure">404</p>
		<h1 class="title">Esta página no existe</h1>
		<p class="bajada">
			Puede que el enlace esté roto o que el artículo haya cambiado de dirección.
		</p>

		<div class="clusters rule-t">
			{
				CLUSTER_IDS.map((id) => (
					<a href={`/${id}/`}>{CLUSTERS[id].short}</a>
				))
			}
		</div>
	</div>
</BaseLayout>

<style>
	.error {
		padding-block: clamp(3rem, 8vw, 6rem);
		max-width: 44rem;
	}

	.codigo {
		font-weight: 700;
		font-size: clamp(3rem, 10vw, 5.5rem);
		line-height: 0.9;
		letter-spacing: -0.04em;
		color: var(--regla);
	}

	.title {
		margin-top: 1rem;
	}

	.bajada {
		margin-top: 1rem;
		color: var(--grafito);
	}

	.clusters {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		font-weight: 700;
	}

	.clusters a {
		color: var(--tinta);
		text-decoration: none;
	}

	.clusters a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
