---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, CLUSTERS, CLUSTER_IDS } from '../consts';
import { getArticles } from '../lib/articles';
import { authorPath, getAuthor } from '../lib/authors';

const articles = await getArticles();

// Conteo real por cluster: el índice dice cuánto hay, no lo promete.
const porCluster = CLUSTER_IDS.map((id) => ({
	id,
	meta: CLUSTERS[id],
	total: articles.filter((a) => a.data.cluster === id).length,
}));

const autor = getAuthor(SITE.author);

const siteUrl = Astro.site?.toString();

// Identidad del sitio para Schema.org. El publisher de cada artículo apunta a
// esta misma Organization por su @id.
const siteSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${siteUrl}#website`,
			name: SITE.name,
			url: siteUrl,
			description: SITE.description,
			inLanguage: SITE.lang,
			publisher: { '@id': `${siteUrl}#organization` },
		},
		{
			'@type': 'Organization',
			'@id': `${siteUrl}#organization`,
			name: SITE.name,
			url: siteUrl,
		},
	],
};
---

<BaseLayout title={SITE.titleDefault} description={SITE.description} useTitleTemplate={false}>
	<JsonLd slot="head" schema={siteSchema} />
	<section class="wrap portada">
		<h1 class="display">Certificaciones IT explicadas en español, sin humo</h1>
		<div class="portada-pie">
			<div>
				<p class="portada-bajada">
					Qué certificación sirve para qué, cuánto cuesta, cuánto lleva prepararla y qué puestos
					abre de verdad. Desde la primera certificación hasta la especialización.
				</p>
				<p class="portada-autor">
					Por <a href={authorPath(autor)}>{autor.name}</a>. {autor.shortBio}
				</p>
			</div>
			<p class="portada-total figure">
				{articles.length}
				<span>{articles.length === 1 ? 'guía' : 'guías'}</span>
			</p>
		</div>
	</section>

	<section class="wrap" aria-labelledby="indice">
		<h2 id="indice" class="seccion-titulo">Índice</h2>

		{
			porCluster.map(({ id, meta, total }) => (
				<div class="banda rule-t">
					<div class="banda-riel">
						<a href={`/${id}/`} class="banda-nombre">
							{meta.short}
						</a>
						<p class="meta figure">
							{total} {total === 1 ? 'guía' : 'guías'}
						</p>
					</div>

					<ul class="banda-lista">
						{articles
							.filter((a) => a.data.cluster === id)
							.map((a) => (
								<li>
									<a href={`/${a.data.cluster}/${a.id.split('/').pop()}/`} class="index-link">
										{a.data.title}
									</a>
								</li>
							))}
					</ul>
				</div>
			))
		}
	</section>

	<div class="wrap">
		<AdSlot placement="home" minHeight={280} />
	</div>
</BaseLayout>

<style>
	.portada {
		padding-block: clamp(3rem, 9vw, 6rem);
	}

	.portada-pie {
		display: grid;
		gap: 1.5rem;
		margin-top: 2rem;
		align-items: start;
	}

	@media (min-width: 48rem) {
		.portada-pie {
			grid-template-columns: minmax(0, 40rem) auto;
			justify-content: space-between;
		}
	}

	.portada-bajada {
		color: var(--grafito);
		font-size: 1.0625rem;
		max-width: 40rem;
	}

	.portada-autor {
		margin-top: 1rem;
		font-size: 0.9375rem;
		color: var(--grafito);
		max-width: 40rem;
	}

	.portada-autor a {
		color: var(--tinta);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.portada-total {
		font-weight: 700;
		font-size: clamp(2.5rem, 7vw, 4rem);
		line-height: 0.9;
		letter-spacing: -0.04em;
	}

	.portada-total span {
		display: block;
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0;
		color: var(--grafito);
		margin-top: 0.375rem;
	}

	.seccion-titulo {
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--grafito);
		padding-bottom: 0.75rem;
	}

	.banda {
		display: grid;
		gap: 0.75rem 2.5rem;
		padding-block: 1.75rem;
	}

	@media (min-width: 48rem) {
		.banda {
			grid-template-columns: 9.5rem minmax(0, 1fr);
		}
	}

	.banda-nombre {
		font-weight: 700;
		font-size: 1.0625rem;
		text-decoration: none;
		color: var(--tinta);
	}

	.banda-nombre:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.banda-riel > * + * {
		margin-top: 0.25rem;
	}

	.banda-lista {
		display: grid;
		gap: 0.875rem;
	}
</style>
