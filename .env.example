# ===========================================================================
# REQUERIDA — definir antes del primer deploy de producción
# ===========================================================================
#
# Es la única variable que hay que completar sí o sí. El build no falla sin
# ella, pero usa un placeholder, y entonces el canonical, el Open Graph, el
# sitemap y el robots.txt apuntan todos a un dominio que no es el tuyo:
# Google indexaría URLs equivocadas.
#
# Sin barra final. En Cloudflare Pages se carga en Settings -> Variables and Secrets.
# Es un valor de build: al cambiarla hay que redeployar.
#
# Mientras siga sin definir, cada build lo avisa por consola.
SITE_URL="https://www.tu-dominio.com"


# ===========================================================================
# OPCIONALES — el sitio funciona perfecto sin ninguna de estas
# ===========================================================================

# --- Integraciones opcionales (todas apagadas si la variable está vacía) ---
#
# Si GA y AdSense están apagados, el sitio no muestra banner de cookies ni
# emite JavaScript: no hay nada que consentir. En cuanto se enciende alguno,
# aparece el banner y los scripts se cargan solo tras la aceptación.

# Google Analytics 4. Formato: G-XXXXXXXXXX
PUBLIC_GA_ID=""

# Meta tag de verificación de Google Search Console (solo el valor del content=)
PUBLIC_GSC_VERIFICATION=""

# Google AdSense. Formato: ca-pub-0000000000000000
# También genera /ads.txt (aunque AdSense siga apagado): cargalo antes de pedir la
# revisión de la cuenta.
PUBLIC_ADSENSE_CLIENT=""

# Interruptor del script de AdSense. Dejar en "false" hasta que la cuenta
# esté APROBADA: cargar el script antes de la aprobación no sirve de nada
# y ensucia el rendimiento.
PUBLIC_ADSENSE_ENABLED="false"

# ---------------------------------------------------------------------------
# IDs DE BLOQUE DE ADSENSE — COMPLETAR ANTES DE ACTIVAR ADSENSE EN PRODUCCIÓN
# ---------------------------------------------------------------------------
#
# Hay un bloque de anuncios por ubicación. Cada id se saca del panel de AdSense
# (Anuncios -> Por bloque de anuncios -> crear bloque -> copiar el data-ad-slot).
# Son números, por ejemplo: 1234567890
#
# Checklist para encender AdSense:
#   1. Cuenta de AdSense APROBADA.
#   2. PUBLIC_ADSENSE_CLIENT con el ca-pub-... real.
#   3. Las TRES variables de abajo con ids reales.
#   4. Recién entonces PUBLIC_ADSENSE_ENABLED="true".
#   5. Redeploy (son valores de build, no de runtime).
#
# Comportamiento si falta alguna (fail closed): ese bloque NO se renderiza —
# ni el anuncio ni el hueco vacío. El resto del sitio funciona igual, y el
# build imprime un aviso nombrando la variable que falta. Un id en cero
# ("0000000000") se trata como placeholder, o sea: tampoco se renderiza.

# Bloque de los artículos. Se usa en tres lugares: antes del primer H2, en el
# medio de los artículos largos (6+ H2 y 1.200+ palabras) y al final, antes de
# los relacionados. AdSense permite repetir un mismo bloque en la página.
# Si falta, no aparece ninguno de los tres.
PUBLIC_ADSENSE_SLOT_ARTICLE=""

# Bloque en los listados por categoría (/entrada/, /redes/, ...).
PUBLIC_ADSENSE_SLOT_CATEGORY=""

# Bloque en la home, entre los últimos artículos y las categorías.
PUBLIC_ADSENSE_SLOT_HOME=""
