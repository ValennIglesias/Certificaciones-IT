# Dominio de producción. Se usa para canonical, Open Graph, sitemap y robots.txt.
# Sin barra final.
SITE_URL="https://www.tu-dominio.com"

# --- Integraciones opcionales (todas apagadas si la variable está vacía) ---

# Google Analytics 4. Formato: G-XXXXXXXXXX
PUBLIC_GA_ID=""

# Meta tag de verificación de Google Search Console (solo el valor del content=)
PUBLIC_GSC_VERIFICATION=""

# Google AdSense. Formato: ca-pub-0000000000000000
PUBLIC_ADSENSE_CLIENT=""

# Interruptor del script de AdSense. Dejar en "false" hasta que la cuenta
# esté APROBADA: cargar el script antes de la aprobación no sirve de nada
# y ensucia el rendimiento.
PUBLIC_ADSENSE_ENABLED="false"
